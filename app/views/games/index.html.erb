<% content_for :title, "Tic-Tac-Toe" %>

<h1>Tic-Tac-Toe</h1>

<div class="difficulty">
  Computer plays:
  <% ComputerPlayer::DIFFICULTIES.each do |difficulty| %>
    <%= button_to difficulty.capitalize, game_path, method: :patch, params: { difficulty: difficulty },
                  class: [ "difficulty-option", { selected: @game.difficulty == difficulty } ],
                  form_class: "difficulty-form", aria: { pressed: @game.difficulty == difficulty } %>
  <% end %>
</div>

<p class="status">
  <% if @game.winner == Game::HUMAN %>
    You win!
  <% elsif @game.winner %>
    The computer wins.
  <% elsif @game.draw? %>
    It's a draw.
  <% else %>
    Your move (<%= Game::HUMAN %>)
  <% end %>
</p>

<% if flash[:alert] %>
  <p class="alert"><%= flash[:alert] %></p>
<% end %>

<div class="board">
  <% @game.cells.each_with_index do |mark, i| %>
    <% if mark == Game::EMPTY && !@game.over? %>
      <%= button_to "", move_game_path, params: { index: i }, class: "cell playable", form_class: "cell-form",
                    data: { index: i }, aria: { label: "Play square #{i + 1}" } %>
    <% else %>
      <div class="cell" data-index="<%= i %>"><%= mark unless mark == Game::EMPTY %></div>
    <% end %>
  <% end %>
</div>

<%= button_to "Reset", reset_game_path, class: "reset" %>
